                "auth",
                "login"
              ]
            },
            "description": "Username/parol bilan access va refresh token oladi. Ikkalasi avtomatik saqlanadi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ali\",\n  \"password\": \"Str0ng-pass-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access', json.access);",
                  "pm.collectionVariables.set('refresh', json.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
